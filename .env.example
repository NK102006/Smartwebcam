# Copy this file to .env and fill in real values.
# Never commit the real .env file to git.

# Flask session signing key — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Groq API key for the chat assistant feature
GROQ_API_KEY=

# Set to "true" only for local development
FLASK_DEBUG=false

# Comma-restricted origin(s) allowed to connect via Socket.IO in production
# e.g. https://yourapp.onrender.com  — avoid "*" once you have a real domain
CORS_ALLOWED_ORIGINS=*
